# Copy this file to .env, then run: php artisan key:generate
APP_NAME="Store Orders"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Log channel. The "log" mailer below also writes the confirmation email here
# (storage/logs/laravel.log).
LOG_CHANNEL=stack
LOG_LEVEL=debug

# MySQL 8.0.16+ or MariaDB 10.6+ (InnoDB, CHECK constraints are enforced).
# Create the database first. The automated tests use a separate database,
# "store_orders_test" (forced in phpunit.xml), which must also exist.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=store_orders
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file

# Order confirmation emails are queued; process them with: php artisan queue:work
QUEUE_CONNECTION=database

# "log" writes emails to the log file instead of sending them (no SMTP needed).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="orders@store.test"
MAIL_FROM_NAME="${APP_NAME}"

# A product is low stock when its quantity is strictly below this value.
LOW_STOCK_THRESHOLD=10
